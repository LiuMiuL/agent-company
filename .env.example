# ─────────────────────────────────────────────────────────────
# Agent Company — environment template
# Copy to `.env` (repo root). Apps read it through turbo globalEnv.
#
# 모든 값은 선택입니다. 비워두면 해당 기능만 꺼지고 앱은 정상 동작합니다.
# ─────────────────────────────────────────────────────────────

# ── 사이트 기본 ───────────────────────────────────────────────
# canonical · sitemap · OG 태그에 쓰입니다. 배포 시 실제 도메인으로 바꾸세요.
# 공백이 들어간 값은 반드시 따옴표로 감싸세요 — 셸 문법으로 읽힙니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Agent Blog"
NEXT_PUBLIC_SITE_DESCRIPTION="AI 에이전트 팀이 기획하고, 검수하고, 발행하는 블로그."
NEXT_PUBLIC_SITE_LOCALE=ko-KR

# 앱 포트. 다른 프로젝트와 충돌하면 여기서 바꾸세요.
WEB_PORT=3000
ADMIN_PORT=3001

# ── 콘텐츠 저장소 ─────────────────────────────────────────────
# 마크다운 콘텐츠 루트 (레포 루트 기준).
CONTENT_DIR=content

# 드라이버 강제 지정: file | supabase
# 비워두면 Supabase 키 유무로 자동 선택됩니다. 이관 중에 유용합니다.
# CONTENT_DRIVER=file

# ── Supabase (비워두면 파일 기반으로 동작) ────────────────────
# 채우고 packages/supabase/migrations 를 적용하면 자동으로 전환됩니다.
# 절차: packages/supabase/migrations/README.md
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# 서버 전용. 절대 클라이언트에 노출하지 마세요 (RLS 를 우회합니다).
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
# 이미지 업로드 버킷 (마이그레이션이 만들어 줍니다).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=post-images

# ── 검색엔진 소유 확인 ────────────────────────────────────────
# Google Search Console → 설정 → 소유권 확인 → HTML 태그의 content 값
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 → 웹마스터 도구 → 사이트 등록 → HTML 태그의 content 값
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Bing Webmaster Tools → msvalidate.01 의 content 값
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── 애널리틱스 ────────────────────────────────────────────────
# GA4 측정 ID. 비워두면 트래커가 아예 로드되지 않습니다.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── 소셜 ──────────────────────────────────────────────────────
# twitter:site 기본값. 글별로 어드민에서 덮어쓸 수 있습니다.
# NEXT_PUBLIC_TWITTER_SITE=@your_handle

# ── 이미지 생성 ─────────────────────────────────────────────────
# 로컬 편집국(content/posts)의 이미지는 Codex `imagegen` 전용입니다.
# 클라우드 워드프레스 발행(scripts/wp-publish.mjs)은 별도 경로로, 대문 이미지만
# OpenAI Images 로 만듭니다 — wiki/decisions/ADR-0004-cloud-wordpress-publishing.md
IMAGE_PROVIDER=codex
IMAGE_OUTPUT_DIR=apps/web/public/images/posts
# Codex 부재 시 폴백: none | user | websearch
IMAGE_FALLBACK=user
# Codex CLI 의 호출 방식이 다를 때 덮어쓰기 ({out} 과 {prompt} 가 치환됩니다)
# CODEX_IMAGEGEN_CMD=codex imagegen --out {out} "{prompt}"

# ── 클라우드 워드프레스 발행 (scripts/wp-publish.mjs) ──────────
# GitHub Actions 에서는 아래 값들을 Secrets / Variables 로 넣습니다.
# 이 파일에 실제 비밀번호를 적지 말고, 로컬 실행용으로만 복사해 쓰세요.
# 절차: CLOUD_WP_GUIDE.md
#
# WP_URL=https://manyinfo.net
# WP_USER=admin
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# LLM_PROVIDER=auto            # auto | anthropic | openai (있는 키를 자동 사용)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_BASE_URL=          # 테스트·프록시용 (기본 https://api.anthropic.com)
# OPENAI_BASE_URL=             # 테스트·프록시용 (기본 https://api.openai.com)
# TOPIC=
# ARTICLE_JSON=wp-queue/2026-11-20-slug.json   # 있으면 LLM 없이 이 JSON 을 올린다 (API 키 불필요)
# CATEGORY=할인정보
# CATEGORY_FALLBACK=일상·잡담
# STRICT_CATEGORY=false        # true 면 카테고리를 못 찾을 때 실패
# POST_STATUS=auto             # auto(JSON status → 없으면 draft) | draft | publish | pending | private
# GENERATE_IMAGE=true
# IMAGE_MODEL=gpt-image-1
# DRY_RUN=false                # true 면 워드프레스에 쓰지 않고 결과 JSON 만
